# ============================================================
#  影音总控台 · 环境变量模板
#  复制为 .env 后填入你自己的凭据。本模板绝不包含任何真实密钥。
#  所有值均为占位符，直接部署不联网、不报错，但对应功能不会点亮。
# ============================================================

# ---------- 面板自身 ----------
MH_HOST=0.0.0.0
MH_PORT=5678
MH_ADMIN_USER=admin
MH_ADMIN_PASS=changeme            # 首次登录请修改
MH_SECRET_KEY=change-this-to-a-random-32-char-string   # Flask session 签名

# ---------- MySQL（跨库共享给各 Bot / 面板）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=changeme
DB_NAME=embyboss

# ---------- Emby（可多实例，见 config/services.json）----------
EMBY_URL=http://127.0.0.1:8096
EMBY_API_KEY=your_emby_api_key_here

# ---------- MoviePilot ----------
MP_URL=http://127.0.0.1:3000
MP_USER=your_mp_username
MP_PASS=your_mp_password

# ---------- qBittorrent ----------
QB_URL=http://127.0.0.1:8080
QB_USER=your_qb_username
QB_PASS=your_qb_password

# ---------- MediaTidy ----------
MT_URL=http://127.0.0.1:2019
MT_USER=your_mt_username
MT_PASS=your_mt_password

# ---------- CloudDrive2 ----------
CD2_URL=http://127.0.0.1:19798

# ---------- TMDB ----------
TMDB_API_KEY=your_tmdb_api_key_here

# ---------- HTTP 代理（访问 TMDB/TG 等外网；不需要可留空）----------
PROXY_HOST=
PROXY_PORT=

# ---------- Telegram Bots ----------
TG_BOT_TOKEN=your_bot_id:your_bot_token_here
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_OWNER_UID=your_telegram_numeric_uid

# ---------- deploy/docker-compose.yml 引用的补充键（占位即可）----------
# 与上方「面板自身」段并存：本地直跑用上面那组，Docker 编排用这一组。
PTDB_USER=changeme
PTDB_PASS=changeme
KFC_MASTER_KEY=                     # 留空由面板首次启动生成；升级时不要改动
RT_URL=http://127.0.0.1:8080
RT_USER=your_rt_username
RT_PASS=your_rt_password
PT2CLOUD_DB_PASS=changeme
